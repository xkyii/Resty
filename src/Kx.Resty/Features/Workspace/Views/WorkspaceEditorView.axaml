<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kx.Resty.Features.Workspace.ViewModels"
             x:Class="Kx.Resty.Features.Workspace.Views.WorkspaceEditorView"
             x:DataType="vm:WorkspaceEditorViewModel">

    <Grid>
        <!-- State overlays: no workspace / empty workspace / collection browsing -->
        <Border CornerRadius="8" Padding="16"
                BorderThickness="1" BorderBrush="#3A7D7D7D" Background="#11000000"
                IsVisible="{Binding IsNoWorkspaceState}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding StateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StateDescription}" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border CornerRadius="8" Padding="16"
                BorderThickness="1" BorderBrush="#3A7D7D7D" Background="#11000000"
                IsVisible="{Binding IsEmptyWorkspaceState}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding StateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StateDescription}" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border CornerRadius="8" Padding="16"
                BorderThickness="1" BorderBrush="#3A7D7D7D" Background="#11000000"
                IsVisible="{Binding IsCollectionBrowsingState}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding StateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StateDescription}" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Editor: visible when request is selected -->
        <TabControl IsVisible="{Binding IsEditorVisible}"
                    ItemsSource="{Binding OpenTabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}">

            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RequestTabItem">
                    <TextBlock Text="{Binding RequestName}" MaxWidth="160"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:RequestTabItem">
                    <Grid RowDefinitions="*,6,*" Margin="4">

                        <!-- ── Top half: Request editor ─────────────────── -->
                        <Border Grid.Row="0" CornerRadius="8" Padding="12"
                                BorderThickness="1" BorderBrush="#3A7D7D7D" Background="#11000000">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

                                <!-- Info row: collection / request-name / Save / Refresh -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding CollectionName}"
                                               VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text=" /"
                                               VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding RequestName, Mode=TwoWay}"
                                             Height="28"/>
                                    <Button Grid.Column="3" Content="保存" Height="28" Classes="Tertiary"
                                            Command="{Binding SaveCommand}"/>
                                    <Button Grid.Column="4" Content="刷新" Height="28" Classes="Tertiary"
                                            Command="{Binding RefreshCommand}"/>
                                </Grid>

                                <!-- Method + URL + Send -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <ComboBox Width="110" Height="32"
                                              ItemsSource="{Binding HttpMethods}"
                                              SelectedItem="{Binding Method, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="1" Height="32"
                                             Classes="code"
                                             Text="{Binding Url, Mode=TwoWay}"
                                             Watermark="https://..."/>
                                    <Button Grid.Column="2" Content="Send" Height="32"
                                            Command="{Binding SendCommand}"
                                            IsEnabled="{Binding !IsSending}"/>
                                </Grid>

                                <!-- Queries / Headers / Body / Auth tab strip -->
                                <TabControl Grid.Row="2"
                                            SelectedIndex="{Binding ActiveRequestTab, Mode=TwoWay}">
                                    <TabItem Header="Queries">
                                        <TextBlock Text="Query 参数编辑器（待实现）"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.5"/>
                                    </TabItem>
                                    <TabItem Header="Headers">
                                        <TextBox AcceptsReturn="True"
                                                 Classes="code"
                                                 Text="{Binding HeadersText, Mode=TwoWay}"
                                                 Watermark="每行一个 Header，例如: Content-Type: application/json"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"/>
                                    </TabItem>
                                    <TabItem Header="Body">
                                        <TextBox AcceptsReturn="True"
                                                 Classes="code"
                                                 Text="{Binding BodyText, Mode=TwoWay}"
                                                 Watermark="请求体"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"/>
                                    </TabItem>
                                    <TabItem Header="Auth">
                                        <TextBlock Text="认证配置（待实现）"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.5"/>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>

                        <!-- ── Divider ────────────────────────────────────── -->
                        <Border Grid.Row="1" Height="2" Background="#337D7D7D"
                                VerticalAlignment="Center"/>

                        <!-- ── Bottom half: Response viewer ──────────────── -->
                        <Border Grid.Row="2" CornerRadius="8" Padding="12"
                                BorderThickness="1" BorderBrush="#3A7D7D7D" Background="#11000000">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">

                                <!-- Meta bar: status / time / size + tab strip -->
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResponseCode}"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResponseTime}"
                                               Opacity="0.7" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ResponseSize}"
                                               Opacity="0.7" VerticalAlignment="Center"/>
                                    <TabStrip Grid.Column="4"
                                              SelectedIndex="{Binding ActiveResponseTab, Mode=TwoWay}">
                                        <TabStripItem>Body</TabStripItem>
                                        <TabStripItem>Headers</TabStripItem>
                                        <TabStripItem>Cookies</TabStripItem>
                                    </TabStrip>
                                </Grid>

                                <!-- Response content -->
                                <Border Grid.Row="1" Background="#0A000000" CornerRadius="4">
                                    <TextBox Margin="8"
                                             Classes="code"
                                             Text="{Binding CurrentResponseContent}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>

</UserControl>
