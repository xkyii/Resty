<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kx.Resty.Features.DirectoryManager.ViewModels"
             x:Class="Kx.Resty.Features.DirectoryManager.Views.DirectoryManagerView"
             x:DataType="vm:DirectoryManagerViewModel">

    <Grid ColumnDefinitions="280,*" ColumnSpacing="8">

        <!-- Left: NavMenu -->
        <Border Grid.Column="0"
                CornerRadius="8"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#3A7D7D7D"
                Background="#11000000">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBox Grid.Row="0"
                    Watermark="搜索"
                    Text="{Binding SearchText, Mode=TwoWay}"
                    Height="32"/>
                <u:NavMenu Grid.Row="1"
                    ItemsSource="{Binding MenuRoots}"
                    HeaderBinding="{Binding Header}"
                    SubMenuBinding="{Binding Children}"
                    DoubleTapped="NavMenuDoubleTapped"
                    SelectedItem="{Binding SelectedMenuNode, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Right: Toolbar + Detail -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    CornerRadius="8"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="#3A7D7D7D"
                    Background="#11000000">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开"
                            Classes="Tertiary"
                            IsEnabled="{Binding HasSelection}"
                            Command="{Binding OpenInWorkspaceCommand}"/>
                    <Button Content="在资源管理器中打开"
                            Classes="Tertiary"
                            IsEnabled="{Binding HasSelection}"
                            Command="{Binding RevealInExplorerCommand}"/>
                    <Button Content="移除"
                            Classes="Tertiary"
                            IsEnabled="{Binding HasSelection}"
                            Command="{Binding RemoveEntryCommand}"/>
                    <Button Content="加入收藏"
                            Classes="Tertiary"
                            IsVisible="{Binding CanAddToManaged}"
                            Command="{Binding AddToManagedCommand}"/>
                    <Button Content="打开文件夹"
                            Classes="Tertiary"
                            Click="OpenFolderButton_Click"/>
                    <TextBlock Text="{Binding ErrorBanner}"
                               IsVisible="{Binding HasError}"
                               VerticalAlignment="Center"
                               Foreground="#FF4D4F"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Detail panel -->
            <Border Grid.Row="1"
                    CornerRadius="8"
                    Padding="16"
                    BorderThickness="1"
                    BorderBrush="#3A7D7D7D"
                    Background="#11000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="目录信息" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding SelectedTypeText, StringFormat=类型: {0}}"/>
                    <TextBlock Text="{Binding SelectedName, StringFormat=名称: {0}}"/>
                    <TextBlock Text="{Binding SelectedPath, StringFormat=路径: {0}}"/>
                    <TextBlock Text="{Binding SelectedLastOpenedText, StringFormat=最近打开: {0}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="状态: "/>
                        <TextBlock Text="{Binding SelectedEntry.StatusText}"
                                   Foreground="{Binding SelectedEntry.StatusColor}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedEntry.HttpFileCountText, StringFormat=文件: {0}}"
                               IsVisible="{Binding HasSelection}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
