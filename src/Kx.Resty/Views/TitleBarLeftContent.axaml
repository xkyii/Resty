<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kx.Resty.Features.Shell.ViewModels"
             x:Class="Kx.Resty.Views.TitleBarLeftContent"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Margin="8,0,0,0">

        <Border Width="20"
                Height="20"
                CornerRadius="5"
                Background="#222222"
                VerticalAlignment="Center">
            <TextBlock Text="R"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Menu VerticalAlignment="Center" Background="Transparent">
            <MenuItem Header="文件">
                <MenuItem Header="偏好设置" Command="{Binding ShowPreferencesCommand}"/>
                <Separator/>
                <MenuItem Header="退出" Command="{Binding QuitCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>
    </StackPanel>

</UserControl>
