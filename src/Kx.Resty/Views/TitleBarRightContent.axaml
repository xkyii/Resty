<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kx.Resty.Features.Shell.ViewModels"
             x:Class="Kx.Resty.Views.TitleBarRightContent"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,4,0">

        <!-- Mode toggle button -->
        <Button Width="36" Height="28" Classes="Tertiary"
                IsEnabled="{Binding IsModeSwitchEnabled}"
                ToolTip.Tip="{Binding WorkspaceSwitchHint}"
                Command="{Binding ToggleModeCommand}">
            <TextBlock Text="⇄" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- Mode label -->
        <Border Width="120" Height="28" CornerRadius="4" Background="#22000000">
            <TextBlock Text="{Binding ModeTitle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Open folder button -->
        <Button Width="36" Height="28" Classes="Tertiary"
                ToolTip.Tip="打开目录"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OpenFolderButton_Click">
            <TextBlock Text="&#xE8B7;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>

    </StackPanel>

</UserControl>
