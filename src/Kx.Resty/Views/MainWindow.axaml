<u:UrsaWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:Kx.Resty.Features.Shell.ViewModels"
             xmlns:views="using:Kx.Resty.Views"
             x:Class="Kx.Resty.Views.MainWindow"
             x:DataType="vm:MainWindowViewModel"
             Title="Resty"
             Width="1280" Height="800"
             MinWidth="1000" MinHeight="640"
             WindowStartupLocation="CenterScreen">

    <u:UrsaWindow.LeftContent>
        <views:TitleBarLeftContent/>
    </u:UrsaWindow.LeftContent>

    <u:UrsaWindow.TitleBarContent>
        <views:TitleBarRightContent/>
    </u:UrsaWindow.TitleBarContent>

    <views:MainView/>

</u:UrsaWindow>
