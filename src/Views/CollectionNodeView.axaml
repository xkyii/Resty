<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Kx.Resty.Models"
             xmlns:v="using:Kx.Resty.Views"
             xmlns:c="using:Kx.Resty.Converters"
             x:Class="Kx.Resty.Views.CollectionNodeView"
             x:DataType="models:CollectionTreeNode">
  <StackPanel Orientation="Vertical">

    <!-- ── Node header row ──────────────────────────────────────── -->
            <Border Height="26" Cursor="Hand"
              Classes.selected="{Binding IsSelected}"
              PointerPressed="OnCollectionNodePointerPressed"
              DoubleTapped="OnCollectionNodeDoubleTapped">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{DynamicResource Text.Panel.RenameCollection}"
                    IsVisible="{Binding !IsDirectory}"
                    Click="OnRenameCollectionClicked"/>
        </ContextMenu>
      </Border.ContextMenu>
      <Border.Background>
        <Binding Path="IsSelected" Converter="{x:Static c:SelectionBrushConverters.SelectedBrush}"/>
      </Border.Background>
      <Border.Styles>
        <Style Selector="Border:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
        </Style>
      </Border.Styles>
      <Grid ColumnDefinitions="Auto,Auto,*">

        <!-- Expand/collapse chevron: two static paths avoid RenderTransform offset -->
        <Button Grid.Column="0"
                Classes="icon_button"
                Width="36" Height="26"
                Margin="0"
                Padding="0"
                Click="OnToggleClicked">
          <Panel Width="8" Height="8"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Path Width="8" Height="8"
                  Data="{StaticResource Icons.Chevron.Down}"
                  IsVisible="{Binding IsExpanded}"/>
            <Path Width="8" Height="8"
                  Data="{StaticResource Icons.Chevron.Right}"
                  IsVisible="{Binding !IsExpanded}"/>
          </Panel>
        </Button>

        <!-- Icon: folder (directory) or file icon (.http collection) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <Path Width="12" Height="12"
                Data="{StaticResource Icons.Folder}"
                IsVisible="{Binding IsDirectory}"/>
          <Path Width="12" Height="12"
                Data="{StaticResource Icons.File}"
                IsVisible="{Binding !IsDirectory}"/>
        </StackPanel>

        <!-- Name -->
        <TextBlock Grid.Column="2"
                   Text="{Binding Name}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>

    <!-- ── Expanded children ────────────────────────────────────── -->
    <StackPanel IsVisible="{Binding IsExpanded}" Margin="16,0,0,0">

      <!-- Sub-folders / sibling .http files (IsDirectory = true) -->
      <ItemsControl ItemsSource="{Binding Children}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:CollectionTreeNode">
            <v:CollectionNodeView DataContext="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Request entries (.http collection node) -->
      <ItemsControl ItemsSource="{Binding Collection.Requests}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:HttpRequestEntry">
              <Border Height="26"
                Cursor="Hand"
                Classes.selected="{Binding IsSelected}"
                PointerPressed="OnRequestEntryPointerPressed">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{DynamicResource Text.Panel.RenameRequest}"
                            Click="OnRenameRequestClicked"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Border.Background>
                <Binding Path="IsSelected" Converter="{x:Static c:SelectionBrushConverters.SelectedBrush}"/>
              </Border.Background>
              <Border.Styles>
                <Style Selector="Border:pointerover">
                  <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
                </Style>
              </Border.Styles>
              <Grid ColumnDefinitions="Auto,Auto,*">
                <Border Grid.Column="0" Width="28"/>
                <!-- HTTP method badge -->
                <Border Grid.Column="1"
                        Padding="4,0" Height="16" CornerRadius="3"
                        Background="{Binding MethodBrushKey, Converter={x:Static c:BrushConverters.MethodBrush}}">
                  <TextBlock Text="{Binding Method}"
                             FontSize="9" FontWeight="Bold"
                             Foreground="White"
                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayName}"
                           FontSize="11"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </StackPanel>
</UserControl>
