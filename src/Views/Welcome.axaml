<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kx.Resty.ViewModels"
             xmlns:m="using:Kx.Resty.Models"
             xmlns:c="using:Kx.Resty.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Kx.Resty.Views.Welcome"
             x:DataType="vm:MainWindow">
  <Grid ColumnDefinitions="210,1,*">

    <!-- ══════════════ Left nav ══════════════ -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource Brush.Sidebar}">

      <!-- Header -->
      <Border Grid.Row="0"
              Padding="14,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Resty}"/>
          <TextBlock Text="工作区" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <!-- Tree list -->
      <ScrollViewer Grid.Row="1" Padding="0,8,0,4">
        <StackPanel>

          <!-- ─ RECENT section ─ -->
          <TextBlock Text="最近"
                     Margin="14,0,14,3"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Classes="dim"
                     Opacity="0.55"/>

          <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:WorkspaceEntry">
                <Border Background="{Binding IsSelected, Converter={x:Static c:SelectionBrushConverters.SelectedBrush}}"
                        Padding="14,5"
                        Cursor="Hand"
                        PointerPressed="OnRecentEntryPressed"
                        DoubleTapped="OnEntryDoubleTapped">
                  <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0"
                          Width="12" Height="12"
                          Data="{StaticResource Icons.Folder}"
                          Margin="0,0,7,0"
                          Opacity="0.5"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Path}"
                                 FontSize="10"
                                 Classes="dim"
                                 TextTrimming="CharacterEllipsis"
                                 Opacity="0.5"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="暂无最近记录"
                     Margin="14,4"
                     FontSize="11"
                     Classes="dim"
                     Opacity="0.4"
                     IsVisible="{Binding HasNoRecentWorkspaces}"/>

          <Border Height="10"/>

          <!-- ─ MANAGED section ─ -->
          <TextBlock Text="目录"
                     Margin="14,0,14,3"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Classes="dim"
                     Opacity="0.55"/>

          <ItemsControl ItemsSource="{Binding ManagedWorkspaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:WorkspaceEntry">
                <Border Background="{Binding IsSelected, Converter={x:Static c:SelectionBrushConverters.SelectedBrush}}"
                        Padding="14,5"
                        Cursor="Hand"
                        PointerPressed="OnManagedEntryPressed"
                        DoubleTapped="OnEntryDoubleTapped">
                  <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0"
                          Width="12" Height="12"
                          Data="{StaticResource Icons.Folder}"
                          Margin="0,0,7,0"
                          Opacity="0.5"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Path}"
                                 FontSize="10"
                                 Classes="dim"
                                 TextTrimming="CharacterEllipsis"
                                 Opacity="0.5"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="暂无已管理目录"
                     Margin="14,4"
                     FontSize="11"
                     Classes="dim"
                     Opacity="0.4"
                     IsVisible="{Binding HasNoManagedWorkspaces}"/>

        </StackPanel>
      </ScrollViewer>

      <!-- Bottom: add button -->
      <Border Grid.Row="2"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource Brush.Border0}">
        <Button Classes="icon_button"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="14,9"
                Command="{Binding AddDirectoryCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="11" Height="11" Data="{StaticResource Icons.Add}"/>
            <TextBlock Text="添加目录" FontSize="12"/>
          </StackPanel>
        </Button>
      </Border>
    </Grid>

    <!-- Separator -->
    <Border Grid.Column="1" Background="{DynamicResource Brush.Border0}"/>

    <!-- ══════════════ Right panel ══════════════ -->
    <Grid Grid.Column="2" Background="{DynamicResource Brush.Window}">

      <!-- State A: nothing selected -->
      <StackPanel IsVisible="{Binding HasNoSelectedEntry}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10">
        <Path Width="52" Height="52"
              HorizontalAlignment="Center"
              Data="{StaticResource Icons.Resty}"
              Opacity="0.35"/>
        <TextBlock Text="{DynamicResource Text.Welcome.Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource Text.Welcome.Subtitle}"
                   FontSize="13"
                   Classes="dim"
                   HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
          <Button Classes="flat primary"
                  Padding="20,8"
                  Command="{Binding AddDirectoryCommand}">
            添加目录
          </Button>
          <Button Classes="flat"
                  Padding="20,8"
                  Command="{Binding OpenDirectoryCommand}">
            打开目录
          </Button>
        </StackPanel>
        <StackPanel Spacing="5" Margin="0,10,0,0" HorizontalAlignment="Center">
          <TextBlock Text="① 选择一个目录作为工作区"
                     FontSize="12" Classes="dim" HorizontalAlignment="Center"/>
          <TextBlock Text="② Resty 会自动扫描其中的 .http 文件"
                     FontSize="12" Classes="dim" HorizontalAlignment="Center"/>
          <TextBlock Text="③ 在左侧导航中浏览集合与请求"
                     FontSize="12" Classes="dim" HorizontalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- State B: entry selected -->
      <ScrollViewer IsVisible="{Binding HasSelectedEntry}"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="36,32,36,24">
        <StackPanel Spacing="20" MaxWidth="600">

          <!-- Title + Open -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Text="{Binding SelectedEntry.Name}"
                         FontSize="22"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding SelectedEntry.Path}"
                         FontSize="11"
                         Classes="dim"
                         TextWrapping="Wrap"
                         Opacity="0.6"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="flat primary"
                    Margin="16,0,0,0"
                    Padding="20,9"
                    VerticalAlignment="Top"
                    IsEnabled="{Binding SelectedEntry.IsValid}"
                    Command="{Binding OpenEntryCommand}"
                    CommandParameter="{Binding SelectedEntry}">
              打开
            </Button>
          </Grid>

          <!-- Divider -->
          <Border Height="1" Background="{DynamicResource Brush.Border0}"/>

          <!-- Status row -->
          <Grid ColumnDefinitions="80,*">
            <TextBlock Grid.Column="0" Text="状态" FontSize="12" Classes="dim" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="● 正常"
                       FontSize="12"
                       VerticalAlignment="Center"
                       IsVisible="{Binding SelectedEntry.IsValid}"/>
            <TextBlock Grid.Column="1"
                       Text="⚠ 目录不存在"
                       FontSize="12"
                       VerticalAlignment="Center"
                       IsVisible="{Binding SelectedEntry.IsMissing}"/>
          </Grid>

          <!-- Last opened row -->
          <Grid ColumnDefinitions="80,*">
            <TextBlock Grid.Column="0" Text="上次打开" FontSize="12" Classes="dim" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedEntry.LastOpenedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
          </Grid>

          <!-- Divider -->
          <Border Height="1" Background="{DynamicResource Brush.Border0}"/>

          <!-- Operations -->
          <TextBlock Text="操作" FontSize="11" Classes="dim" Opacity="0.6" FontWeight="SemiBold"/>

          <!-- Reveal in Explorer (only when valid) -->
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding SelectedEntry.IsValid}">
            <Button Classes="flat"
                    Command="{Binding RevealInExplorerCommand}"
                    CommandParameter="{Binding SelectedEntry}">
              在资源管理器中显示
            </Button>
          </StackPanel>

          <!-- Management actions -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Add to managed (shown when selected entry is from Recent) -->
            <Button Classes="flat"
                    IsVisible="{Binding SelectedEntryIsFromRecent}"
                    Command="{Binding AddToManagedCommand}"
                    CommandParameter="{Binding SelectedEntry}">
              加入目录管理
            </Button>
            <!-- Remove from managed (shown when selected from managed list) -->
            <Button Classes="flat"
                    IsVisible="{Binding SelectedEntryIsFromManaged}"
                    Command="{Binding RemoveFromManagedCommand}"
                    CommandParameter="{Binding SelectedEntry}">
              从管理列表移除
            </Button>
            <!-- Remove from recent (only from recent) -->
            <Button Classes="flat"
                    IsVisible="{Binding SelectedEntryIsFromRecent}"
                    Command="{Binding RemoveFromRecentCommand}"
                    CommandParameter="{Binding SelectedEntry}">
              从最近记录移除
            </Button>
          </StackPanel>

          <!-- Hint for missing directory -->
          <TextBlock Text="该目录已不可访问，你可以将其从列表中移除，稍后重新添加正确的路径。"
                     FontSize="12"
                     Classes="dim"
                     TextWrapping="Wrap"
                     Opacity="0.7"
                     IsVisible="{Binding SelectedEntry.IsMissing}"/>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</UserControl>
