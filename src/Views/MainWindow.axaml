<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="using:Kx.Resty"
                    xmlns:vm="using:Kx.Resty.ViewModels"
                    xmlns:v="using:Kx.Resty.Views"
                    mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
                    x:Class="Kx.Resty.Views.MainWindow"
                    x:DataType="vm:MainWindow"
                    x:Name="ThisWindow"
                    Classes="custom_window_frame"
                    Title="{Binding Title}"
                    MinWidth="900" MinHeight="600"
                    Width="1280" Height="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ══════════════════════════ TitleBar ══════════════════════════ -->
    <Grid Grid.Row="0"
          Background="{DynamicResource Brush.TitleBar}"
          ColumnDefinitions="Auto,Auto,*,Auto"
          PointerPressed="TitleBarPointerPressed"
          DoubleTapped="TitleBarDoubleTapped">

      <!-- Bottom border -->
      <Border Grid.Column="0" Grid.ColumnSpan="4"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"/>

      <!-- macOS: left caption button placeholder -->
      <Border Grid.Column="0"
              Width="{Binding #ThisWindow.LeftCaptionButtonWidth}"
              IsVisible="{Binding #ThisWindow.HasLeftCaptionButton}"/>

      <!-- App icon (Windows/Linux) -->
      <Border Grid.Column="0"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              IsVisible="{OnPlatform True, macOS=False}">
        <Path Width="16" Height="16" Data="{StaticResource Icons.Resty}"/>
      </Border>

      <!-- Top-left menu (Windows/Linux) -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  IsVisible="{OnPlatform True, macOS=False}">
        <Button Classes="icon_button"
                Height="32"
                Padding="10,0">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" VerticalOffset="-6">
              <MenuItem Header="{DynamicResource Text.Menu.Preferences}"
                        Command="{x:Static s:App.OpenPreferencesCommand}"/>
              <Separator Margin="0,2"/>
              <MenuItem Header="{DynamicResource Text.Menu.Quit}"
                        Command="{x:Static v:MainWindow.QuitCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
          <TextBlock Text="{DynamicResource Text.Menu.File}" FontSize="14"/>
        </Button>

        <Button Classes="icon_button"
                Height="32"
                Padding="10,0">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" VerticalOffset="-6">
              <MenuItem Header="{DynamicResource Text.Menu.About}"
                        Command="{x:Static v:MainWindow.OpenAboutCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
          <TextBlock Text="{DynamicResource Text.Menu.Help}" FontSize="14"/>
        </Button>
      </StackPanel>

      <!-- Workspace tabs bar -->
      <ScrollViewer Grid.Column="2"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Workspaces}"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTab">
              <Border MinWidth="140" MaxWidth="220" Height="32"
                      BorderThickness="0,0,1,0"
                      BorderBrush="{DynamicResource Brush.Border0}"
                      Background="Transparent"
                      Classes.active_tab="{Binding IsActive}"
                      Cursor="Hand">
                <Grid ColumnDefinitions="*,24">
                  <!-- Selected background for workspace tab -->
                  <Border Grid.Column="0" Grid.ColumnSpan="2"
                          Background="{DynamicResource Brush.AccentSelected}"
                          IsVisible="{Binding IsActive}"/>

                  <Button Grid.Column="0"
                          Classes="icon_button"
                          HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                          Command="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).SwitchWorkspaceCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                  </Button>
                  <Button Grid.Column="1"
                      Classes="icon_button"
                          Width="20" Height="20"
                          Margin="0,0,4,0"
                      IsVisible="{Binding $parent[Border].IsPointerOver}"
                          Command="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).CloseWorkspaceCommand}"
                          CommandParameter="{Binding}">
                    <Path Width="8" Height="8" Data="{StaticResource Icons.Window.Close}"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Windows/Linux caption buttons -->
      <StackPanel Grid.Column="3"
                  Orientation="Horizontal"
                  IsVisible="{OnPlatform True, macOS=False}">
        <Button Classes="caption_button"
                Click="MinimizeWindow">
          <Path Width="10" Height="10" Data="{StaticResource Icons.Window.Minimize}"/>
        </Button>
        <Button Classes="caption_button max_or_restore_btn"
                Click="MaximizeWindow">
          <Path Width="10" Height="10"/>
        </Button>
        <Button Classes="caption_button close_btn"
                Click="CloseWindow">
          <Path Width="10" Height="10" Data="{StaticResource Icons.Window.Close}"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══════════════════════════ Body ══════════════════════════ -->
      <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left sidebar (per-workspace) -->
      <v:CollectionPanel Grid.Column="0"
             MinWidth="260"
             DataContext="{Binding ActiveWorkspace.SidePanel}"
             Background="{DynamicResource Brush.Sidebar}"
             IsVisible="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).HasWorkspaces}"/>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    IsVisible="{Binding HasWorkspaces}"/>

      <!-- Right content -->
      <Grid Grid.Column="2" Background="{DynamicResource Brush.Window}" RowDefinitions="Auto,*">

        <!-- ── Request sub-tab bar ─────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.TitleBar}"
                IsVisible="{Binding HasCollections}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Border0}">
        <Grid ColumnDefinitions="*,32">
          <ScrollViewer Grid.Column="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ActiveWorkspace.OpenRequests}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RequestTabItem">
                  <Border MinWidth="120" MaxWidth="200" Height="32"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{DynamicResource Brush.Border0}"
                          Background="Transparent"
                          Classes.active_tab="{Binding IsActive}"
                          Cursor="Hand">
                    <Grid ColumnDefinitions="*,22">
                      <!-- Selected background for request tab -->
                      <Border Grid.Column="0" Grid.ColumnSpan="2"
                              Background="{DynamicResource Brush.AccentSelected}"
                              IsVisible="{Binding IsActive}"/>

                      <Button Grid.Column="0"
                              Classes="icon_button"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Command="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).ActiveWorkspace.SwitchRequestCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Title}"
                                   Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="11"/>
                      </Button>
                      <Button Grid.Column="1"
                              Classes="icon_button"
                              Width="18" Height="18"
                              Margin="0,0,2,0"
                              Command="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).ActiveWorkspace.CloseRequestCommand}"
                              CommandParameter="{Binding}">
                        <Path Width="7" Height="7" Data="{StaticResource Icons.Window.Close}"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!-- New request button -->
          <Button Grid.Column="1"
                  Classes="icon_button"
                  Width="32" Height="32"
                  ToolTip.Tip="{DynamicResource Text.Panel.NewRequest}"
                  Command="{Binding ActiveWorkspace.NewRequestCommand}">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Add}"/>
          </Button>
        </Grid>
        </Border>

        <!-- ── Editor / placeholder area ─────────────────────────── -->
        <Grid Grid.Row="1">
          <!-- Welcome page (no workspace open) -->
          <v:Welcome DataContext="{Binding}"
                     IsVisible="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).HasNoWorkspaces}"/>

          <!-- No collections in current workspace -->
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8"
                      IsVisible="{Binding HasNoCollections}">
            <TextBlock Text="{DynamicResource Text.Empty.NoCollections}"
                       Classes="dim"
                       HorizontalAlignment="Center"
                       FontSize="14"/>
            <TextBlock Text="{DynamicResource Text.Empty.NoCollections.Sub}"
                       Classes="dim"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6"/>
            <TextBlock Text="(右键点击左侧'Collections'来新建或导入集合)"
                       Classes="dim"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       Opacity="0.5"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <!-- No request open (workspace open, no active request) -->
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="6"
                      IsVisible="{Binding HasCollectionsButNoRequest}">
            <TextBlock Text="{DynamicResource Text.Empty.NoRequest}"
                       Classes="dim"
                       HorizontalAlignment="Center"
                       FontSize="14"/>
            <TextBlock Text="{DynamicResource Text.Empty.NoRequest.Sub}"
                       Classes="dim"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6"/>
          </StackPanel>

          <!-- Active request editor -->
          <v:RequestTab DataContext="{Binding ActiveWorkspace.ActiveRequest.Content}"
                        IsVisible="{Binding $parent[v:MainWindow].((vm:MainWindow)DataContext).HasActiveRequest}"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</v:ChromelessWindow>
