<views:ChromelessWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kx.Resty.Views"
             xmlns:vm="using:Kx.Resty.ViewModels"
             xmlns:c="using:Kx.Resty.Converters"
             x:Class="Kx.Resty.Views.Dialogs.Preferences"
             x:DataType="vm:Preferences"
             Title="{DynamicResource Text.Preferences.Title}"
             Width="400" Height="260"
             CanResize="False"
             WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Title bar -->
    <Border Grid.Row="0" Height="32" Background="{DynamicResource Brush.TitleBar}">
      <TextBlock Text="{DynamicResource Text.Preferences.Title}"
                 Foreground="{DynamicResource Brush.FG1}"
                 FontWeight="SemiBold"
                 FontSize="13"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"/>
    </Border>

    <!-- Content -->
    <StackPanel Grid.Row="1" Margin="24,20" Spacing="16">
      <!-- Theme -->
      <Grid ColumnDefinitions="120,*">
        <TextBlock Grid.Column="0"
                   Text="{DynamicResource Text.Preferences.Theme}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG1}"
                   FontSize="13"/>
        <ComboBox Grid.Column="1"
                  DisplayMemberBinding="{Binding Key, x:DataType=ThemeVariant}"
                  SelectedItem="{Binding Theme, Mode=TwoWay, Converter={x:Static c:StringConverters.ToTheme}}"
                  HorizontalAlignment="Stretch">
          <ComboBox.Items>
            <ThemeVariant>Default</ThemeVariant>
            <ThemeVariant>Dark</ThemeVariant>
            <ThemeVariant>Light</ThemeVariant>
          </ComboBox.Items>
        </ComboBox>
      </Grid>

      <!-- Language -->
      <Grid ColumnDefinitions="120,*">
        <TextBlock Grid.Column="0"
                   Text="{DynamicResource Text.Preferences.Language}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG1}"
                   FontSize="13"/>
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Source={x:Static c:Locale.Supported}}"
                  DisplayMemberBinding="{Binding Name, x:DataType=c:Locale}"
                  SelectedItem="{Binding Locale, Mode=TwoWay, Converter={x:Static c:StringConverters.ToLocale}}"
                  HorizontalAlignment="Stretch"/>
      </Grid>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="24,0,24,20"
                Spacing="8">
      <Button Classes="flat"
              Width="80"
              HorizontalContentAlignment="Center"
              Click="OnOKClicked">
        <TextBlock Text="{DynamicResource Text.Preferences.OK}" FontSize="13"/>
      </Button>
    </StackPanel>
  </Grid>
</views:ChromelessWindow>
