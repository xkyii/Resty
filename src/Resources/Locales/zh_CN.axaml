<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="Text.App.Name">Kx.Resty</x:String>

  <!-- TitleBar / Menu -->
  <x:String x:Key="Text.Menu.Preferences">偏好设置</x:String>
  <x:String x:Key="Text.Menu.About">关于</x:String>
  <x:String x:Key="Text.Menu.Quit">退出</x:String>

  <!-- Welcome -->
  <x:String x:Key="Text.Welcome.Title">欢迎使用 Kx.Resty</x:String>
  <x:String x:Key="Text.Welcome.Subtitle">现代化的 REST API 客户端</x:String>
  <x:String x:Key="Text.Welcome.NewRequest">新建请求</x:String>
  <x:String x:Key="Text.Welcome.NewCollection">新建集合</x:String>

  <x:String x:Key="Text.Welcome.OpenDirectory">打开目录</x:String>
  <x:String x:Key="Text.Welcome.OpenDirectoryHint">打开包含 .http 集合文件的目录</x:String>

  <!-- 空状态 -->
  <x:String x:Key="Text.Empty.NoCollections">当前工作区还没有 .http 集合文件</x:String>
  <x:String x:Key="Text.Empty.NoCollections.Sub">请先新建或导入集合文件</x:String>
  <x:String x:Key="Text.Empty.NoRequest">从左侧选择一个请求开始编辑</x:String>
  <x:String x:Key="Text.Empty.NoRequest.Sub">点击左侧集合中的请求，或在当前集合中新建请求</x:String>

  <!-- CollectionPanel -->
  <x:String x:Key="Text.Panel.Search">搜索...</x:String>
  <x:String x:Key="Text.Panel.Collections">集合</x:String>
  <x:String x:Key="Text.Panel.Environments">环境</x:String>
  <x:String x:Key="Text.Panel.History">历史</x:String>
  <x:String x:Key="Text.Panel.NewCollection">新建集合</x:String>
  <x:String x:Key="Text.Panel.ImportCollection">导入集合</x:String>
  <x:String x:Key="Text.Panel.RenameCollection">重命名</x:String>
  <x:String x:Key="Text.Panel.RenameRequest">重命名</x:String>
  <x:String x:Key="Text.Panel.RenameCollectionPrompt">请输入新的集合名称</x:String>
  <x:String x:Key="Text.Panel.EnterCollectionName">集合名称</x:String>
  <x:String x:Key="Text.Panel.Renaming">正在重命名...</x:String>
  <x:String x:Key="Text.Panel.RenameFailedDuplicate">重命名失败：该名称已存在</x:String>
  <x:String x:Key="Text.Panel.NewRequest">新建请求</x:String>

  <!-- Common -->
  <x:String x:Key="Text.Common.OK">确定</x:String>
  <x:String x:Key="Text.Common.Cancel">取消</x:String>

  <!-- RequestTab -->
  <x:String x:Key="Text.Request.Name">名称：</x:String>
  <x:String x:Key="Text.Request.NamePlaceholder">请求名称</x:String>
  <x:String x:Key="Text.Request.Collection">集合：</x:String>
  <x:String x:Key="Text.Request.Save">保存</x:String>
  <x:String x:Key="Text.Request.SaveState.Saved">已保存</x:String>
  <x:String x:Key="Text.Request.SaveState.Unsaved">有未保存更改</x:String>
  <x:String x:Key="Text.Request.SaveState.Unlinked">未保存请求</x:String>
  <x:String x:Key="Text.Request.Collection.Unlinked">（未关联集合）</x:String>
  <x:String x:Key="Text.Request.Send.Invalid">请求无效</x:String>
  <x:String x:Key="Text.Request.Send.InvalidHint">请先输入有效 URL 再发送。</x:String>
  <x:String x:Key="Text.Request.Send">发送</x:String>
  <x:String x:Key="Text.Request.URLPlaceholder">输入请求 URL</x:String>
  <x:String x:Key="Text.Request.Tab.Params">查询参数</x:String>
  <x:String x:Key="Text.Request.Tab.Headers">请求头</x:String>
  <x:String x:Key="Text.Request.Tab.Body">请求体</x:String>
  <x:String x:Key="Text.Request.Tab.Auth">认证</x:String>
  <x:String x:Key="Text.Request.Auth.Type">认证类型</x:String>
  <x:String x:Key="Text.Request.Auth.Username">用户名</x:String>
  <x:String x:Key="Text.Request.Auth.Password">密码</x:String>
  <x:String x:Key="Text.Request.NoResponse">发送请求后查看响应</x:String>
  <x:String x:Key="Text.Response.Tab.Body">响应体</x:String>
  <x:String x:Key="Text.Response.Tab.Headers">响应头</x:String>
  <x:String x:Key="Text.Response.Tab.Cookies">Cookies</x:String>

  <!-- Preferences Dialog -->
  <x:String x:Key="Text.Preferences.Title">偏好设置</x:String>
  <x:String x:Key="Text.Preferences.Section.Appearance">外观</x:String>
  <x:String x:Key="Text.Preferences.Theme">主题</x:String>
  <x:String x:Key="Text.Preferences.Theme.System">跟随系统</x:String>
  <x:String x:Key="Text.Preferences.Theme.Light">浅色</x:String>
  <x:String x:Key="Text.Preferences.Theme.Dark">深色</x:String>
  <x:String x:Key="Text.Preferences.Language">语言</x:String>
  <x:String x:Key="Text.Preferences.Section.General">通用</x:String>
  <x:String x:Key="Text.Preferences.OK">确定</x:String>
  <x:String x:Key="Text.Preferences.Cancel">取消</x:String>
</ResourceDictionary>
