<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="Text.App.Name">Kx.Resty</x:String>

  <!-- TitleBar / Menu -->
  <x:String x:Key="Text.Menu.Preferences">偏好设置</x:String>
  <x:String x:Key="Text.Menu.About">关于</x:String>
  <x:String x:Key="Text.Menu.Quit">退出</x:String>

  <!-- Welcome -->
  <x:String x:Key="Text.Welcome.Title">欢迎使用 Kx.Resty</x:String>
  <x:String x:Key="Text.Welcome.Subtitle">现代化的 REST API 客户端</x:String>
  <x:String x:Key="Text.Welcome.NewRequest">新建请求</x:String>
  <x:String x:Key="Text.Welcome.NewCollection">新建集合</x:String>

  <!-- CollectionPanel -->
  <x:String x:Key="Text.Panel.Search">搜索...</x:String>
  <x:String x:Key="Text.Panel.Collections">集合</x:String>
  <x:String x:Key="Text.Panel.Environments">环境</x:String>
  <x:String x:Key="Text.Panel.History">历史</x:String>
  <x:String x:Key="Text.Panel.NewCollection">新建集合</x:String>
  <x:String x:Key="Text.Panel.NewRequest">新建请求</x:String>

  <!-- RequestTab -->
  <x:String x:Key="Text.Request.Send">发送</x:String>
  <x:String x:Key="Text.Request.URLPlaceholder">输入请求 URL</x:String>
  <x:String x:Key="Text.Request.Tab.Params">参数</x:String>
  <x:String x:Key="Text.Request.Tab.Headers">请求头</x:String>
  <x:String x:Key="Text.Request.Tab.Body">请求体</x:String>
  <x:String x:Key="Text.Request.Tab.Auth">认证</x:String>
  <x:String x:Key="Text.Request.NoResponse">发送请求后查看响应</x:String>
  <x:String x:Key="Text.Response.Tab.Body">响应体</x:String>
  <x:String x:Key="Text.Response.Tab.Headers">响应头</x:String>
  <x:String x:Key="Text.Response.Tab.Cookies">Cookies</x:String>

  <!-- Preferences Dialog -->
  <x:String x:Key="Text.Preferences.Title">偏好设置</x:String>
  <x:String x:Key="Text.Preferences.Section.Appearance">外观</x:String>
  <x:String x:Key="Text.Preferences.Theme">主题</x:String>
  <x:String x:Key="Text.Preferences.Theme.System">跟随系统</x:String>
  <x:String x:Key="Text.Preferences.Theme.Light">浅色</x:String>
  <x:String x:Key="Text.Preferences.Theme.Dark">深色</x:String>
  <x:String x:Key="Text.Preferences.Language">语言</x:String>
  <x:String x:Key="Text.Preferences.Section.General">通用</x:String>
  <x:String x:Key="Text.Preferences.OK">确定</x:String>
  <x:String x:Key="Text.Preferences.Cancel">取消</x:String>
</ResourceDictionary>
