<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Window">#FFF0F5F9</Color>
      <Color x:Key="Color.WindowBorder">#FF999999</Color>
      <Color x:Key="Color.TitleBar">#FFCFDEEA</Color>
      <Color x:Key="Color.Sidebar">#FFE4EEF5</Color>
      <Color x:Key="Color.Popup">#FFF8F8F8</Color>
      <Color x:Key="Color.Contents">#FFFAFAFA</Color>
      <Color x:Key="Color.Border0">#FFCFCFCF</Color>
      <Color x:Key="Color.Border1">#FF898989</Color>
      <Color x:Key="Color.Border2">#FFCFCFCF</Color>
      <Color x:Key="Color.FlatButton.Background">#FFF8F8F8</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">White</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF898989</Color>
      <Color x:Key="Color.FG1">#FF1F1F1F</Color>
      <Color x:Key="Color.FG2">#FF6F6F6F</Color>
      <Color x:Key="Color.Badge">#FFB0CEE8</Color>
      <Color x:Key="Color.BadgeFG">#FF1F1F1F</Color>
      <Color x:Key="Color.Method.GET">#FF0078D7</Color>
      <Color x:Key="Color.Method.POST">#FF107C10</Color>
      <Color x:Key="Color.Method.PUT">#FFFF8C00</Color>
      <Color x:Key="Color.Method.DELETE">#FFE81123</Color>
      <Color x:Key="Color.Method.PATCH">#FF744DA9</Color>
      <Color x:Key="Color.AccentSelected">#FFC1D8EA</Color>
      <Color x:Key="Color.Status.2xx">#FF107C10</Color>
      <Color x:Key="Color.Status.3xx">#FFFF8C00</Color>
      <Color x:Key="Color.Status.4xx">#FFE81123</Color>
      <Color x:Key="Color.Status.5xx">#FF744DA9</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Window">#FF252525</Color>
      <Color x:Key="Color.WindowBorder">#FF606060</Color>
      <Color x:Key="Color.TitleBar">#FF1F1F1F</Color>
      <Color x:Key="Color.Sidebar">#FF2A2A2A</Color>
      <Color x:Key="Color.Popup">#FF2B2B2B</Color>
      <Color x:Key="Color.Contents">#FF1C1C1C</Color>
      <Color x:Key="Color.Border0">#FF181818</Color>
      <Color x:Key="Color.Border1">#FF7C7C7C</Color>
      <Color x:Key="Color.Border2">#FF404040</Color>
      <Color x:Key="Color.FlatButton.Background">#FF303030</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#FF333333</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF4F4F4F</Color>
      <Color x:Key="Color.FG1">#FFDDDDDD</Color>
      <Color x:Key="Color.FG2">#40F1F1F1</Color>
      <Color x:Key="Color.Badge">#FF8F8F8F</Color>
      <Color x:Key="Color.BadgeFG">#FFDDDDDD</Color>
      <Color x:Key="Color.Method.GET">#FF4DAAFC</Color>
      <Color x:Key="Color.Method.POST">#FF6CCB5F</Color>
      <Color x:Key="Color.Method.PUT">#FFFFB900</Color>
      <Color x:Key="Color.Method.DELETE">#FFFF6B6B</Color>
      <Color x:Key="Color.Method.PATCH">#FFB29BEB</Color>
      <Color x:Key="Color.AccentSelected">#FF2D4A5E</Color>
      <Color x:Key="Color.Status.2xx">#FF6CCB5F</Color>
      <Color x:Key="Color.Status.3xx">#FFFFB900</Color>
      <Color x:Key="Color.Status.4xx">#FFFF6B6B</Color>
      <Color x:Key="Color.Status.5xx">#FFB29BEB</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="Brush.Window"      Color="{DynamicResource Color.Window}"/>
  <SolidColorBrush x:Key="Brush.WindowBorder" Color="{DynamicResource Color.WindowBorder}"/>
  <SolidColorBrush x:Key="Brush.TitleBar"    Color="{DynamicResource Color.TitleBar}"/>
  <SolidColorBrush x:Key="Brush.Sidebar"     Color="{DynamicResource Color.Sidebar}"/>
  <SolidColorBrush x:Key="Brush.Popup"       Color="{DynamicResource Color.Popup}"/>
  <SolidColorBrush x:Key="Brush.Contents"    Color="{DynamicResource Color.Contents}"/>
  <SolidColorBrush x:Key="Brush.Border0"     Color="{DynamicResource Color.Border0}"/>
  <SolidColorBrush x:Key="Brush.Border1"     Color="{DynamicResource Color.Border1}"/>
  <SolidColorBrush x:Key="Brush.Border2"     Color="{DynamicResource Color.Border2}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.Background"      Color="{DynamicResource Color.FlatButton.Background}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.BackgroundHovered" Color="{DynamicResource Color.FlatButton.BackgroundHovered}"/>
  <SolidColorBrush x:Key="Brush.FlatButton.FloatingBorder"  Color="{DynamicResource Color.FlatButton.FloatingBorder}"/>
  <SolidColorBrush x:Key="Brush.FG1"         Color="{DynamicResource Color.FG1}"/>
  <SolidColorBrush x:Key="Brush.FG2"         Color="{DynamicResource Color.FG2}"/>
  <SolidColorBrush x:Key="Brush.Accent"      Color="{DynamicResource SystemAccentColor}"/>
  <SolidColorBrush x:Key="Brush.AccentHovered" Color="{DynamicResource SystemListLowColor}"/>
  <SolidColorBrush x:Key="Brush.AccentSelected" Color="{DynamicResource Color.AccentSelected}"/>
  <SolidColorBrush x:Key="Brush.Badge"       Color="{DynamicResource Color.Badge}"/>
  <SolidColorBrush x:Key="Brush.BadgeFG"     Color="{DynamicResource Color.BadgeFG}"/>
  <SolidColorBrush x:Key="Brush.Method.GET"    Color="{DynamicResource Color.Method.GET}"/>
  <SolidColorBrush x:Key="Brush.Method.POST"   Color="{DynamicResource Color.Method.POST}"/>
  <SolidColorBrush x:Key="Brush.Method.PUT"    Color="{DynamicResource Color.Method.PUT}"/>
  <SolidColorBrush x:Key="Brush.Method.DELETE" Color="{DynamicResource Color.Method.DELETE}"/>
  <SolidColorBrush x:Key="Brush.Method.PATCH"  Color="{DynamicResource Color.Method.PATCH}"/>
  <SolidColorBrush x:Key="Brush.Status.2xx"   Color="{DynamicResource Color.Status.2xx}"/>
  <SolidColorBrush x:Key="Brush.Status.3xx"   Color="{DynamicResource Color.Status.3xx}"/>
  <SolidColorBrush x:Key="Brush.Status.4xx"   Color="{DynamicResource Color.Status.4xx}"/>
  <SolidColorBrush x:Key="Brush.Status.5xx"   Color="{DynamicResource Color.Status.5xx}"/>

  <FontFamily x:Key="Fonts.Default">fonts:Inter#Inter</FontFamily>
  <FontFamily x:Key="Fonts.Monospace">Consolas,Menlo,monospace</FontFamily>
</ResourceDictionary>
