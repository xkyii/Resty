<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Resty.Rebuild.Desktop.ViewModels"
        xmlns:wvm="using:Resty.Rebuild.Desktop.Features.Workspace.ViewModels"
    xmlns:u="https://irihi.tech/ursa"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Resty.Rebuild.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Resty.Rebuild"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="640"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40">

    <Window.Styles>
        <Style Selector="Button.caption_btn">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.caption_btn:pointerover">
            <Setter Property="Background" Value="#22000000"/>
        </Style>
        <Style Selector="Button.close_btn:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.panel_card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A7D7D7D"/>
            <Setter Property="Background" Value="#11FFFFFF"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="40,*">

        <!-- Title bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Background="#1EFFFFFF"
              PointerPressed="TitleBarPointerPressed"
              DoubleTapped="TitleBarDoubleTapped">

            <!-- Left: File / Help -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Height="40" Padding="12,0" BorderThickness="0" Background="Transparent">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="偏好设置"/>
                            <Separator/>
                            <MenuItem Header="退出" Click="CloseWindow"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="File" VerticalAlignment="Center"/>
                </Button>

                <Button Height="40" Padding="12,0" BorderThickness="0" Background="Transparent">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="关于"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="Help" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Center: mode switch + workspace name + workspace quick switch -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button Width="36"
                        Height="32"
                        IsEnabled="{Binding IsModeSwitchEnabled}"
                    ToolTip.Tip="{Binding WorkspaceSwitchHint}"
                        Command="{Binding ToggleModeCommand}">
                    <TextBlock Text="⇄" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Border Width="180" Height="32" CornerRadius="6" Background="#22000000">
                    <TextBlock Text="{Binding ModeTitle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Context-aware button in title bar right-center -->
                <Button Width="48" Height="32" Padding="4,0" BorderThickness="0" Background="Transparent" Click="OpenFolderButton_Click" ToolTip.Tip="打开文件夹">
                    <Panel>
                        <!-- Directory Manager mode: folder icon -->
                        <TextBlock IsVisible="{Binding IsDirectoryManagerMode}"
                                   Text="📁"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <!-- Workspace mode: dropdown icon -->
                        <TextBlock IsVisible="{Binding IsWorkspaceMode}"
                                   Text="▼"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Panel>
                </Button>
            </StackPanel>

            <!-- Right: caption buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="caption_btn" Click="MinimizeWindow">
                    <TextBlock Text="-" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="caption_btn" Click="ToggleMaximizeWindow">
                    <TextBlock Text="□" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Classes="caption_btn close_btn" Click="CloseWindow">
                    <TextBlock Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="8" ColumnDefinitions="300,*,*" ColumnSpacing="8">

            <!-- Left shared panel -->
            <Border Grid.Column="0" Classes="panel_card">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBox IsVisible="{Binding IsDirectoryManagerMode}"
                             Watermark="搜索&quot;最近&quot;或&quot;目录&quot;"
                             Text="{Binding DirectoryManager.SearchText, Mode=TwoWay}"
                             Height="32"/>

                    <TextBox IsVisible="{Binding IsWorkspaceMode}"
                             Watermark="搜索&quot;集合&quot;或&quot;历史&quot;"
                             Text="{Binding WorkspaceNavigation.SearchText, Mode=TwoWay}"
                             Height="32"/>

                    <!-- 工作区模式：集合 / 历史 切换 -->
                    <StackPanel Grid.Row="1" IsVisible="{Binding IsWorkspaceMode}"
                                Orientation="Horizontal" Spacing="4">
                        <Button Content="集合"
                                Classes.accent="{Binding WorkspaceNavigation.IsCollectionsMode}"
                                Command="{Binding WorkspaceNavigation.ShowCollectionsCommand}"/>
                        <Button Content="历史"
                                Classes.accent="{Binding WorkspaceNavigation.IsHistoryMode}"
                                Command="{Binding WorkspaceNavigation.ShowHistoryCommand}"/>
                    </StackPanel>

                    <u:NavMenu Grid.Row="2"
                               IsVisible="{Binding IsDirectoryManagerMode}"
                               ItemsSource="{Binding DirectoryManager.MenuRoots}"
                               HeaderBinding="{Binding Header}"
                               SubMenuBinding="{Binding Children}"
                               DoubleTapped="DirectoryMenuDoubleTapped"
                               SelectedItem="{Binding DirectoryManager.SelectedMenuNode, Mode=TwoWay}"/>

                    <u:NavMenu Grid.Row="2"
                               IsVisible="{Binding IsWorkspaceMode}"
                               ItemsSource="{Binding WorkspaceNavigation.ActiveMenuRoots}"
                               HeaderBinding="{Binding Header}"
                               SubMenuBinding="{Binding Children}"
                               SelectedItem="{Binding WorkspaceNavigation.SelectedNode, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <!-- Directory Manager mode -->
            <Grid Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsDirectoryManagerMode}" RowDefinitions="Auto,*" RowSpacing="8">
                <Border Grid.Row="0" Classes="panel_card">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开"
                                IsEnabled="{Binding DirectoryManager.HasSelection}"
                                Command="{Binding DirectoryManager.OpenInWorkspaceCommand}"/>
                        <Button Content="在资源管理器中显示"
                                IsEnabled="{Binding DirectoryManager.HasSelection}"
                                Command="{Binding DirectoryManager.RevealInExplorerCommand}"/>
                        <Button Content="移除"
                                IsEnabled="{Binding DirectoryManager.HasSelection}"
                                Command="{Binding DirectoryManager.RemoveEntryCommand}"/>
                        <Button Content="加入收藏"
                                IsVisible="{Binding DirectoryManager.CanAddToManaged}"
                                Command="{Binding DirectoryManager.AddToManagedCommand}"/>
                        <TextBlock Text="请先打开文件夹后再切换到工作区"
                                   IsVisible="{Binding ShouldShowOpenFolderHint}"
                                   VerticalAlignment="Center"
                                   Foreground="#D46B08"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DirectoryManager.ErrorBanner}"
                                   IsVisible="{Binding DirectoryManager.HasError}"
                                   VerticalAlignment="Center"
                                   Foreground="#FF4D4F"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="panel_card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="目录信息" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DirectoryManager.SelectedTypeText, StringFormat=类型: {0}}"/>
                        <TextBlock Text="{Binding DirectoryManager.SelectedName, StringFormat=名称: {0}}"/>
                        <TextBlock Text="{Binding DirectoryManager.SelectedPath, StringFormat=路径: {0}}"/>
                        <TextBlock Text="{Binding DirectoryManager.SelectedLastOpenedText, StringFormat=最近打开: {0}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="状态: "/>
                            <TextBlock Text="{Binding DirectoryManager.SelectedEntry.StatusText}"
                                       Foreground="{Binding DirectoryManager.SelectedEntry.StatusColor}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DirectoryManager.SelectedEntry.HttpFileCountText, StringFormat=文件: {0}}"
                                   IsVisible="{Binding DirectoryManager.HasSelection}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Workspace mode -->
            <Grid Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsWorkspaceMode}">
                <Border Classes="panel_card"
                        IsVisible="{Binding WorkspaceEditor.IsNoWorkspaceState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{Binding WorkspaceEditor.StateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WorkspaceEditor.StateDescription}" Opacity="0.8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Classes="panel_card"
                        IsVisible="{Binding WorkspaceEditor.IsEmptyWorkspaceState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{Binding WorkspaceEditor.StateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WorkspaceEditor.StateDescription}" Opacity="0.8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Classes="panel_card"
                        IsVisible="{Binding WorkspaceEditor.IsCollectionBrowsingState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{Binding WorkspaceEditor.StateTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WorkspaceEditor.StateDescription}" Opacity="0.8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TabControl x:Name="WorkspaceTabs"
                            IsVisible="{Binding WorkspaceEditor.IsEditorVisible}"
                            ItemsSource="{Binding WorkspaceEditor.OpenTabs}"
                            SelectedItem="{Binding WorkspaceEditor.SelectedTab, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="wvm:RequestTabItem">
                            <TextBlock Text="{Binding RequestName}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="wvm:RequestTabItem">
                            <Grid RowDefinitions="*,1,*" Margin="8" RowSpacing="8">

                                <!-- Top half: Request editor -->
                                <Border Grid.Row="0" Classes="panel_card">
                                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

                                        <!-- Info row: 集合名 / 请求名  Save  Refresh -->
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding CollectionName}" VerticalAlignment="Center" Opacity="0.7"/>
                                            <TextBlock Grid.Column="1" Text=" /" VerticalAlignment="Center" Opacity="0.7"/>
                                            <TextBox Grid.Column="2" Text="{Binding RequestName, Mode=TwoWay}"/>
                                            <Button Grid.Column="3" Content="保存" Command="{Binding SaveCommand}"/>
                                            <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshCommand}"/>
                                        </Grid>

                                        <!-- Method + URL + Send -->
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <ComboBox Width="110"
                                                      ItemsSource="{Binding HttpMethods}"
                                                      SelectedItem="{Binding Method, Mode=TwoWay}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Url, Mode=TwoWay}"/>
                                            <Button Grid.Column="2"
                                                    Content="Send"
                                                    Command="{Binding SendCommand}"/>
                                        </Grid>

                                        <!-- Queries / Headers / Body / Auth -->
                                        <TabControl Grid.Row="2" SelectedIndex="{Binding ActiveRequestTab, Mode=TwoWay}">
                                            <TabItem Header="Queries">
                                                <TextBlock Text="请求参数" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </TabItem>
                                            <TabItem Header="Headers">
                                                <TextBox AcceptsReturn="True"
                                                         Text="{Binding HeadersText, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         Watermark="每行一个 Header，例如: Content-Type: application/json"/>
                                            </TabItem>
                                            <TabItem Header="Body">
                                                <TextBox AcceptsReturn="True"
                                                         Text="{Binding BodyText, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         Watermark="请求体"/>
                                            </TabItem>
                                            <TabItem Header="Auth">
                                                <TextBlock Text="认证信息" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Border>

                                <!-- Separator -->
                                <Border Grid.Row="1" Height="1" Background="#337D7D7D"/>

                                <!-- Bottom half: Response viewer -->
                                <Border Grid.Row="2" Classes="panel_card">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">

                                        <!-- Response meta + Body/Headers/Cookies strip -->
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding ResponseCode}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ResponseTime}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ResponseSize}" VerticalAlignment="Center"/>
                                            <TabStrip Grid.Column="4" SelectedIndex="{Binding ActiveResponseTab, Mode=TwoWay}">
                                                <TabStripItem>Body</TabStripItem>
                                                <TabStripItem>Headers</TabStripItem>
                                                <TabStripItem>Cookies</TabStripItem>
                                            </TabStrip>
                                        </Grid>

                                        <!-- Response content area -->
                                        <Border Grid.Row="1" Background="#0A000000" CornerRadius="4">
                                            <TextBox Margin="12"
                                                     Text="{Binding CurrentResponseContent}"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
