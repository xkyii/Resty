<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kx.Resty.Features.Shell.ViewModels"
             x:Class="Kx.Resty.Views.TitleBarRightContent"
             x:DataType="vm:MainWindowViewModel">

    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">

        <!-- Mode toggle button -->
        <Button Width="36" Height="28"
                IsEnabled="{Binding IsModeSwitchEnabled}"
                ToolTip.Tip="{Binding WorkspaceSwitchHint}"
                Command="{Binding ToggleModeCommand}">
            <TextBlock Text="⇄" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- Mode label -->
        <Border Width="120" Height="28" CornerRadius="4" Background="#22000000">
            <TextBlock Text="{Binding ModeTitle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Workspace selector (workspace mode only) -->
        <ComboBox Height="28" MinWidth="140"
                  IsVisible="{Binding IsWorkspaceMode}"
                  ItemsSource="{Binding OpenWorkspaces}"
                  SelectedItem="{Binding SelectedWorkspaceName, Mode=TwoWay}"/>

        <!-- Settings/About menu -->
        <Button Width="28" Height="28" Padding="0">
            <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="关于 Resty"
                              Command="{Binding ShowAboutCommand}"/>
                    <Separator/>
                    <MenuItem Header="退出"
                              Command="{Binding QuitCommand}"/>
                </MenuFlyout>
            </Button.Flyout>
            <TextBlock Text="⋮" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
    </StackPanel>

</UserControl>
